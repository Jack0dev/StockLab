# ============================================
# StockLab ML Service — Environment Variables
# ============================================
# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# KHÔNG BAO GIỜ commit file .env vào git!
# ============================================

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=stock_lap
DB_USER=stocklab
DB_PASSWORD=change_me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- ML Config ---
ML_MODEL_VERSION=v1

# --- API Security ---
# Token để bảo vệ endpoint /admin/train
ML_ADMIN_TOKEN=change_me_too

# --- Google Gemini (Phase 3) ---
GEMINI_API_KEY=your_key_here
